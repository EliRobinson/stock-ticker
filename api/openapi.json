              },
              {
                "type": "null"
              }
            ],
            "title": "Data As Of"
          },
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobStatusEntry"
            },
            "title": "Jobs",
            "type": "array"
          },
          "market_clock": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MarketClock"
              },
              {
                "type": "null"
              }
            ]
          },
          "missing_keys": {
            "items": {
              "type": "string"
            },
            "title": "Missing Keys",
            "type": "array"
          },
          "open_gaps": {
            "title": "Open Gaps",
            "type": "integer"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          }
        },
        "required": [
          "server_time",
          "market_clock",
          "jobs",
          "backfill",
          "missing_keys",
          "data_as_of",
          "open_gaps",
          "ai"
        ],
        "title": "StatusResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Stock Ticker API",
