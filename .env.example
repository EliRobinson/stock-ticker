# Copy this file to .env, at the repo root. Never commit .env.
#
# There is one .env for the whole stack: docker-compose passes it to every
# service with env_file, and web/src/env.ts (@t3-oss/env-nextjs) validates
# the vars web reads out of it.

# The browser calls the API directly at this URL (no Next.js rewrite - a
# rewrite would buffer the /chat SSE stream). Defaults to 127.0.0.1:8000, so
# this only needs setting if the API runs somewhere else.
# NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"

# ---- docker-compose.yml: db, api, worker ----
# Every var below is validated by api/src/stockticker/config.py (Settings) --
# the api/worker still start with the provider keys empty (see N4 in
# docs/design/system-design.md), but the Postgres passwords are required.

# Postgres bootstrap superuser. The `db` service's postgres:17 image creates this
# role (and the database) at first start; api/alembic/versions/0001_initial_schema.py
# then connects as this role to create app_owner/app_writer/ai_reader.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme-local-only
POSTGRES_DB=stockticker

# Application roles the first migration creates. app_owner has no password (NOLOGIN --
# it is an ownership anchor, nothing connects as it). app_writer is used by api and worker
# for reads/writes; ai_reader is used only by the /api/v1/chat SQL guard.
POSTGRES_APP_WRITER_PASSWORD=changeme-local-only
POSTGRES_AI_READER_PASSWORD=changeme-local-only

# Alpaca Markets free-tier API key. Powers live Quotes, Daily Bars, the market calendar,
# and corporate actions (system design §4). Missing keys are reported in /api/v1/status,
# not fatal -- see docs/adr/0001-alpaca-and-sec-edgar-as-free-data-sources.md.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Required by SEC EDGAR as a contact header on every request, e.g. "Jane Doe jane@example.com".
# No API key needed, but a missing/generic User-Agent gets rate-limited or blocked.
SEC_USER_AGENT=

# Anthropic API key. Used only by the api service, for POST /api/v1/chat (Ask). Without it,
# the chat stream sends the error "AI is off. ANTHROPIC_API_KEY is not set."
ANTHROPIC_API_KEY=
# Claude model id used for Ask.
AI_MODEL=claude-sonnet-5
# Soft daily cap on Anthropic input+output tokens across all Ask answers.
AI_DAILY_TOKEN_BUDGET=2000000
# Hard cap on total Anthropic spend, in USD. /api/v1/chat refuses once reached.
AI_SPEND_LIMIT_USD=5.00

# CORS/TrustedHost: the only browser origin the api service accepts requests from.
WEB_ORIGIN=http://127.0.0.1:3000
