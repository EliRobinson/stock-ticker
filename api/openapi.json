{
  "components": {
    "schemas": {
      "AiStatus": {
        "description": "Owned end to end by the AI chat agent's `stockticker.ai.status.\nai_status(settings)` (issue #7's agreed contract) -- this model just\ngives it a shape to return. `StatusResponse.ai` is null until that\nmodule exists and `api/routers/status.py` calls it.",
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "limit_usd": {
            "title": "Limit Usd",
            "type": "number"
          },
          "spend_usd": {
            "title": "Spend Usd",
            "type": "number"
          }
        },
        "required": ["spend_usd", "limit_usd", "enabled"],
        "title": "AiStatus",
        "type": "object"
      },
      "BackfillProgress": {
        "properties": {
          "listings_done": {
            "title": "Listings Done",
            "type": "integer"
          },
          "listings_total": {
            "title": "Listings Total",
            "type": "integer"
          }
        },
        "required": ["listings_done", "listings_total"],
        "title": "BackfillProgress",
        "type": "object"
      },
      "Bar": {
        "properties": {
          "adj_close": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Adj Close",
            "type": "string"
          },
          "close": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Close",
            "type": "string"
          },
          "high": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "High",
            "type": "string"
          },
          "low": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Low",
            "type": "string"
          },
          "open": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Open",
            "type": "string"
          },
          "trade_date": {
            "format": "date",
            "title": "Trade Date",
            "type": "string"
          },
          "volume": {
            "title": "Volume",
            "type": "integer"
          }
        },
        "required": [
          "trade_date",
          "open",
          "high",
          "low",
          "close",
          "volume",
          "adj_close"
        ],
        "title": "Bar",
        "type": "object"
      },
      "BarsResponse": {
        "description": "`timeframe` only ever `\"1d\"` today; echoed back so the client's cache\nkey is unambiguous once intraday timeframes exist (system design \u00a75).",
        "properties": {
          "bars": {
            "items": {
              "$ref": "#/components/schemas/Bar"
            },
            "title": "Bars",
            "type": "array"
          },
          "timeframe": {
            "const": "1d",
            "title": "Timeframe",
            "type": "string"
          }
        },
        "required": ["timeframe", "bars"],
        "title": "BarsResponse",
        "type": "object"
      },
      "CompanyDetail": {
        "properties": {
          "cik": {
            "title": "Cik",
            "type": "string"
          },
          "date_added": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Added"
          },
          "first_bar_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Bar Date"
          },
          "headquarters": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Headquarters"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "listings": {
            "items": {
              "$ref": "#/components/schemas/ListingSummary"
            },
            "title": "Listings",
            "type": "array"
          },
          "market_cap": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MarketCapSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "sector": {
            "title": "Sector",
            "type": "string"
          },
          "sub_industry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sub Industry"
          },
          "week_52_high": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Week 52 High"
          },
          "week_52_low": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Week 52 Low"
          }
        },
        "required": [
          "cik",
          "name",
          "sector",
          "sub_industry",
          "headquarters",
          "date_added",
          "is_active",
          "listings",
          "market_cap",
          "week_52_high",
          "week_52_low",
          "first_bar_date"
        ],
        "title": "CompanyDetail",
        "type": "object"
      },
      "Event": {
        "properties": {
          "cik": {
            "title": "Cik",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "event_date": {
            "format": "date",
            "title": "Event Date",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "split",
              "reverse_split",
              "cash_dividend",
              "symbol_change",
              "spin_off",
              "filing_10k",
              "filing_10q",
              "filing_8k",
              "index_added"
            ],
            "title": "Kind",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "source_ref": {
            "title": "Source Ref",
            "type": "string"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "cik",
          "symbol",
          "event_date",
          "kind",
          "title",
          "details",
          "source",
          "source_ref"
        ],
        "title": "Event",
        "type": "object"
      },
      "EventsPage": {
        "description": "Keyset page of Events (system design \u00a75, amended). A distinct\nsubclass, not a bare `Page[Event]` alias, so the OpenAPI schema keeps\nthe name `EventsPage` instead of a generic-mangled one.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": ["items"],
        "title": "EventsPage",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "`/api/v1/health/live` only: proves the process is up, no DB call.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobStatusEntry": {
        "properties": {
          "consecutive_failures": {
            "title": "Consecutive Failures",
            "type": "integer"
          },
          "error_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Summary"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "job": {
            "title": "Job",
            "type": "string"
          },
          "last_success_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success At"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "running",
                  "succeeded",
                  "partial",
                  "failed",
                  "skipped_locked",
                  "skipped"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "required": [
          "job",
          "status",
          "finished_at",
          "last_success_at",
          "consecutive_failures",
          "error_summary"
        ],
        "title": "JobStatusEntry",
        "type": "object"
      },
      "ListingSummary": {
        "properties": {
          "backfill_completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Backfill Completed At"
          },
          "first_bar_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Bar Date"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "is_primary": {
            "title": "Is Primary",
            "type": "boolean"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "is_primary",
          "is_active",
          "first_bar_date",
          "backfill_completed_at"
        ],
        "title": "ListingSummary",
        "type": "object"
      },
      "MarketCapSummary": {
        "properties": {
          "is_approx": {
            "title": "Is Approx",
            "type": "boolean"
          },
          "market_cap": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Market Cap",
            "type": "string"
          },
          "shares_as_of": {
            "format": "date",
            "title": "Shares As Of",
            "type": "string"
          }
        },
        "required": ["market_cap", "shares_as_of", "is_approx"],
        "title": "MarketCapSummary",
        "type": "object"
      },
      "MarketClock": {
        "description": "Null until the Alpaca agent wires up `fetch_market_clock` (see marketdata.py).",
        "properties": {
          "is_open": {
            "title": "Is Open",
            "type": "boolean"
          },
          "next_close": {
            "format": "date-time",
            "title": "Next Close",
            "type": "string"
          },
          "next_open": {
            "format": "date-time",
            "title": "Next Open",
            "type": "string"
          }
        },
        "required": ["is_open", "next_open", "next_close"],
        "title": "MarketClock",
        "type": "object"
      },
      "MarketResponse": {
        "description": "Reliability review: carries the same market-clock fields as\n`/api/v1/status` so the client never has to combine two cached queries\nto answer \"is the market open\" next to the listings themselves.",
        "properties": {
          "listings": {
            "items": {
              "$ref": "#/components/schemas/MarketRow"
            },
            "title": "Listings",
            "type": "array"
          },
          "market_clock": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MarketClock"
              },
              {
                "type": "null"
              }
            ]
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          }
        },
        "required": ["server_time", "market_clock", "listings"],
        "title": "MarketResponse",
        "type": "object"
      },
      "MarketRow": {
        "properties": {
          "backfill_completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Backfill Completed At"
          },
          "change": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change"
          },
          "change_pct": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Pct"
          },
          "cik": {
            "title": "Cik",
            "type": "string"
          },
          "first_bar_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Bar Date"
          },
          "is_primary": {
            "title": "Is Primary",
            "type": "boolean"
          },
          "market_cap": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market Cap"
          },
          "market_cap_is_approx": {
            "title": "Market Cap Is Approx",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "observed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "prev_close": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prev Close"
          },
          "price": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "sector": {
            "title": "Sector",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "volume": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Volume"
          }
        },
        "required": [
          "symbol",
          "cik",
          "name",
          "sector",
          "is_primary",
          "price",
          "observed_at",
          "prev_close",
          "change",
          "change_pct",
          "volume",
          "market_cap",
          "market_cap_is_approx",
          "first_bar_date",
          "backfill_completed_at"
        ],
        "title": "MarketRow",
        "type": "object"
      },
      "Note": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "cik": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cik"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "cik",
          "start_date",
          "end_date",
          "body",
          "created_at",
          "updated_at"
        ],
        "title": "Note",
        "type": "object"
      },
      "NotePut": {
        "description": "Body of `PUT /api/v1/notes/{id}` (system design \u00a75, amended: the\nclient supplies the id in the path; PUT is an idempotent upsert that\nreplaces the old POST/PATCH).\n\n`end_date` is filled in from `start_date` by a `mode=\"before\"`\nvalidator -- before pydantic's own type coercion runs -- so the field\nis an honest `date` (not `date | None`) by the time anything reads it;\nno `assert` needed downstream to convince the type checker it's set.",
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "cik": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cik"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          }
        },
        "required": ["start_date", "end_date", "body"],
        "title": "NotePut",
        "type": "object"
      },
      "NotesPage": {
        "description": "Keyset page of Notes (system design \u00a75, amended). A distinct\nsubclass, not a bare `Page[Note]` alias, so the OpenAPI schema keeps\nthe name `NotesPage` instead of a generic-mangled one.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Note"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": ["items"],
        "title": "NotesPage",
        "type": "object"
      },
      "ProblemDetail": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-field validation errors, present on 422 responses.",
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["title", "status"],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ReadyResponse": {
        "description": "`/api/v1/health/ready`: DB reachable and schema at the Alembic head.",
        "properties": {
          "database": {
            "const": "ok",
            "title": "Database",
            "type": "string"
          },
          "migration": {
            "const": "ok",
            "title": "Migration",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status", "database", "migration"],
        "title": "ReadyResponse",
        "type": "object"
      },
      "StatusResponse": {
        "properties": {
          "ai": {
            "anyOf": [
