  "components": {
    "schemas": {
      "BackfillProgress": {
        "properties": {
          "listings_done": {
            "type": "integer",
            "title": "Listings Done"
          },
          "listings_total": {
            "type": "integer",
            "title": "Listings Total"
          }
        },
        "type": "object",
        "required": ["listings_done", "listings_total"],
        "title": "BackfillProgress"
      },
      "Bar": {
        "properties": {
          "trade_date": {
            "type": "string",
            "format": "date",
            "title": "Trade Date"
          },
          "open": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Open"
          },
          "high": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "High"
          },
          "low": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Low"
          },
          "close": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Close"
          },
          "volume": {
            "type": "integer",
            "title": "Volume"
          },
          "adj_close": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Adj Close"
          }
        },
        "type": "object",
        "required": [
          "trade_date",
          "open",
          "high",
          "low",
          "close",
          "volume",
          "adj_close"
        ],
        "title": "Bar"
      },
      "CompanyDetail": {
        "properties": {
          "cik": {
            "type": "string",
            "title": "Cik"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "sector": {
            "type": "string",
            "title": "Sector"
          },
          "sub_industry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sub Industry"
          },
          "headquarters": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Headquarters"
          },
          "date_added": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Added"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "listings": {
            "items": {
              "$ref": "#/components/schemas/ListingSummary"
            },
            "type": "array",
            "title": "Listings"
          },
          "market_cap": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MarketCapSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "week_52_high": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Week 52 High"
          },
          "week_52_low": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Week 52 Low"
          },
          "first_bar_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Bar Date"
          }
        },
        "type": "object",
        "required": [
          "cik",
          "name",
          "sector",
          "sub_industry",
          "headquarters",
          "date_added",
          "is_active",
          "listings",
          "market_cap",
          "week_52_high",
          "week_52_low",
          "first_bar_date"
        ],
        "title": "CompanyDetail"
      },
      "Event": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "cik": {
            "type": "string",
            "title": "Cik"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          },
          "event_date": {
            "type": "string",
            "format": "date",
            "title": "Event Date"
          },
          "kind": {
            "type": "string",
            "enum": [
              "split",
              "reverse_split",
              "cash_dividend",
              "symbol_change",
              "spin_off",
              "filing_10k",
              "filing_10q",
              "filing_8k",
              "index_added"
            ],
            "title": "Kind"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "source_ref": {
            "type": "string",
            "title": "Source Ref"
          }
        },
        "type": "object",
        "required": [
          "id",
          "cik",
          "symbol",
          "event_date",
          "kind",
          "title",
          "details",
          "source",
          "source_ref"
        ],
        "title": "Event"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": ["status"],
        "title": "HealthResponse",
        "description": "`/api/v1/health/live` only: proves the process is up, no DB call."
      },
      "JobStatusEntry": {
        "properties": {
          "job": {
            "type": "string",
            "title": "Job"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "running",
                  "succeeded",
                  "partial",
                  "failed",
                  "skipped_locked",
                  "skipped"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "last_success_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success At"
          },
          "consecutive_failures": {
            "type": "integer",
            "title": "Consecutive Failures"
          },
          "error_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Summary"
          }
        },
        "type": "object",
        "required": [
          "job",
          "status",
          "finished_at",
          "last_success_at",
          "consecutive_failures",
          "error_summary"
        ],
        "title": "JobStatusEntry"
      },
      "ListingSummary": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "is_primary": {
            "type": "boolean",
            "title": "Is Primary"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "first_bar_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Bar Date"
          }
        },
        "type": "object",
        "required": ["symbol", "is_primary", "is_active", "first_bar_date"],
        "title": "ListingSummary"
      },
      "MarketCapSummary": {
        "properties": {
          "market_cap": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Market Cap"
          },
          "shares_as_of": {
            "type": "string",
            "format": "date",
            "title": "Shares As Of"
          },
          "is_approx": {
            "type": "boolean",
